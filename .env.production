# Firebase WEB client config — baked into the browser bundle at build time.
# These values IDENTIFY the project; they are not secrets (any browser loading
# the app can read them from the JS). Server-side data access is still
# protected by FIREBASE_SERVICE_ACCOUNT (kept in the private, gitignored .env).
#
# This file is INTENTIONALLY committed (ignored via .gitignore exception) so
# that bundled dist builds — including headless/CI builds that don't have the
# developer's local .env — ship a working login instead of silently falling
# back to "Local" mode.
VITE_FIREBASE_API_KEY=AIzaSyAGo7CWkqZGgqOZ-6ZmtBUJL0WkXWacglM
VITE_FIREBASE_AUTH_DOMAIN=mydata-9e3b4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mydata-9e3b4
VITE_FIREBASE_APP_ID=1:694511710112:web:ee4d90bc133e18ed0c3ec5
VITE_FIREBASE_STORAGE_BUCKET=mydata-9e3b4.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=694511710112
