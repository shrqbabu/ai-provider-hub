# ---------------------------------------------------------------------------
# Analytics backend — SERVER-SIDE ONLY. None of these values ship in the APK.
# ---------------------------------------------------------------------------

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only — never in Android
SUPABASE_JWT_SECRET=                  # server only — verifies client tokens
SUPABASE_PUBLISHABLE_KEY=             # safe to hand to Android via /v1/config

# LLM provider: openai | gemini | deterministic | auto
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=                       # Google AI Studio key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# Storage / limits
BUCKET_INPUTS=project-inputs
BUCKET_ARTIFACTS=project-artifacts
BUCKET_DASHBOARDS=dashboard-images
BUCKET_REPORTS=reports
MAX_UPLOAD_MB=256
MAX_ANALYSIS_ROWS=5000000
SIGNED_URL_TTL_SECONDS=900

# Runtime
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
JOB_WORKERS=2
LOG_LEVEL=INFO

# SQL connectors (optional, read-only)
SQL_CONNECTORS_ENABLED=false
SQL_ALLOWED_DRIVERS=postgresql
SQL_CONNECTIONS=[{"id":"warehouse","label":"Analytics warehouse","driver":"postgresql","dsn_env":"WAREHOUSE_DSN","default_schema":"public"}]
WAREHOUSE_DSN=

# Local/dev only. NEVER enable in production.
DEV_MODE=false
LOCAL_DATA_DIR=./.analytics-data
