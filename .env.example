# ─────────────────────────────────────────────────────────────
# Firebase Web SDK (client) — safe to expose, Vite inlines VITE_* into the bundle.
# Firebase Console → Project Settings → General → Your apps → Web app → SDK config.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK (server) — SECRET. Never commit, never expose to the client.
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Paste the ENTIRE downloaded JSON here as a single line (keep the surrounding quotes).
# On Vercel: add this as an Environment Variable (Production + Preview).
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
