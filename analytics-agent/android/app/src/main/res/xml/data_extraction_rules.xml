<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The session token store is never backed up or transferred to a new device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
