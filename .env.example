# ==========================================
# Server Configuration
# ==========================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Upstream provider time-to-first-byte timeout (milliseconds).
# If a provider doesn't start responding within this window, the gateway
# falls back to the next API key / combo member instead of hanging.
# Streaming bodies are never cut once headers arrive. Default: 60000 (60s). 0 disables.
#GATEWAY_UPSTREAM_TTFB_MS=60000

# ==========================================
# Supabase Configuration (Required for Auth & Storage)
# ==========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==========================================
# Firebase Configuration (Legacy / Optional)
# ==========================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=

# ==========================================
# Google Antigravity OAuth (Optional)
# ==========================================
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
