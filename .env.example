# ==========================================
# Server Configuration
# ==========================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Upstream provider time-to-first-byte timeout (milliseconds).
# If a provider doesn't start responding within this window, the gateway
# falls back to the next API key / combo member instead of hanging.
# Streaming bodies are never cut once headers arrive. Default: 60000 (60s). 0 disables.
#GATEWAY_UPSTREAM_TTFB_MS=60000

# ==========================================
# Firebase Configuration (Required for Auth & Storage)
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin Service Account (JSON string or base64)
FIREBASE_SERVICE_ACCOUNT=

# ==========================================
# Google Antigravity OAuth (Optional)
# ==========================================
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
